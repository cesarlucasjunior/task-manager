# Copie para .env e preencha. O .env real não é versionado.

# PostgreSQL (usado pelo docker-compose e pela aplicação)
POSTGRES_DB=taskmanager
POSTGRES_USER=localuser
POSTGRES_PASSWORD=localuser

# AWS / SQS
AWS_REGION=us-east-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# Fila real: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
# Ou um emulador local (LocalStack / ElasticMQ): http://localhost:4566
SQS_ENDPOINT=
QUEUE_NAME=tasks-queue
